<Window x:Class="Ts3Messenger.Windows.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TS3 Messenger" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="16" CornerRadius="16" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDragArea">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="IconHost" Width="34" Height="34" CornerRadius="17"
                        Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                    <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" LineHeight="21"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>
