<Window x:Class="Ts3Messenger.Windows.PeerPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add members" Height="560" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">
    <Border Background="{DynamicResource PanelBrush}" Margin="16" Padding="16"
            CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="CountText" Grid.Row="1" Margin="0,4,0,10" FontSize="12.5"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <CheckBox x:Name="SelectAllBox" Content="Select all" DockPanel.Dock="Right"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Checked="OnSelectAllChecked" Unchecked="OnSelectAllUnchecked"/>
                <TextBox x:Name="SearchBox" MinHeight="36" FontSize="13.5"
                         Style="{StaticResource ModernTextBoxStyle}"
                         TextChanged="OnSearchChanged"/>
            </DockPanel>
            <ListBox x:Name="PeopleList" Grid.Row="3"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,4"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                            <TextBlock Text="{Binding LoginId}" FontSize="14" Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Click="OnCancel" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="88"/>
                <Button x:Name="ConfirmButton" Click="OnConfirm" IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
