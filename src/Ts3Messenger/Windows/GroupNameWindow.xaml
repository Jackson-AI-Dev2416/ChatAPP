<Window x:Class="Ts3Messenger.Windows.GroupNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Group" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">
    <Border Background="{DynamicResource PanelBrush}" Margin="16" Padding="20"
            CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="New Group" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Group name" Margin="0,16,0,6" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBox x:Name="NameBox" MinHeight="40" FontSize="15"
                     Style="{StaticResource ModernTextBoxStyle}"
                     TextChanged="OnNameChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Click="OnCancel" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="88"/>
                <Button x:Name="NextButton" Content="Next" Click="OnNext" IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
