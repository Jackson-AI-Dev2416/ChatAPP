<Window x:Class="Ts3Messenger.Windows.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image preview" Width="900" Height="700" MinWidth="400" MinHeight="300"
        Background="#0F172A" WindowStartupLocation="CenterOwner"
        PreviewMouseWheel="OnPreviewMouseWheel">
    <Window.Resources>
        <Style x:Key="ZoomButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111827" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ZoomOutButton" Content="−" Click="OnZoomOut" ToolTip="Zoom out"
                        Style="{StaticResource ZoomButtonStyle}"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" Width="52" FontSize="13"
                           Foreground="#E2E8F0" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="ZoomInButton" Content="+" Click="OnZoomIn" ToolTip="Zoom in"
                        Style="{StaticResource ZoomButtonStyle}"/>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Background="#0F172A">
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Image x:Name="PreviewImage" Stretch="None" Margin="16"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
