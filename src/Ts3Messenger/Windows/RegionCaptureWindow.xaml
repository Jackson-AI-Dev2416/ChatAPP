<Window x:Class="Ts3Messenger.Windows.RegionCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Cursor="Cross">
    <Canvas x:Name="RootCanvas" Background="#55000000">
        <Border x:Name="SelectionBorder" BorderBrush="#2563EB" BorderThickness="2"
                Background="#332563EB" Visibility="Collapsed"/>
        <TextBlock Canvas.Left="16" Canvas.Top="16" Foreground="White" FontSize="13"
                   Text="Drag to select · Enter confirm · Esc cancel"/>
    </Canvas>
</Window>
