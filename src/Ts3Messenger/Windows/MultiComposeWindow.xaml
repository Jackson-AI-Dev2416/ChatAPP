<Window x:Class="Ts3Messenger.Windows.MultiComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi message" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">
    <Border Background="{DynamicResource PanelBrush}" Margin="16" Padding="16"
            CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Multi message" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="TargetText" Margin="0,4,0,12" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBox x:Name="BodyBox" MinHeight="88" MaxHeight="160" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource ComposeTextBoxStyle}" FontSize="14"
                     TextChanged="OnBodyChanged"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12.5"
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            <Grid Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="16"
                            Style="{StaticResource IconButtonStyle}" ToolTip="Snapshot"
                            Click="OnSnapshot" x:Name="SnapshotButton"/>
                    <Button Content="&#xE723;" FontFamily="{StaticResource IconFont}" FontSize="16"
                            Style="{StaticResource IconButtonStyle}" ToolTip="File" Margin="4,0,0,0"
                            Click="OnFiles" x:Name="FileButton"/>
                </StackPanel>
                <Button x:Name="SendButton" Content="Send" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="88"
                        Click="OnSend" IsEnabled="False"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
