<Window x:Class="Ts3Messenger.Windows.SnapshotAnnotateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit snapshot" Width="720" Height="560" MinWidth="400" MinHeight="400"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Annotate, then send."
                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
        <Border Grid.Row="1" x:Name="PreviewArea" Background="{DynamicResource DividerBrush}" CornerRadius="8" Padding="4"
                ClipToBounds="True">
            <Viewbox x:Name="PreviewViewbox" Stretch="Uniform" HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Grid x:Name="ImageHost">
                    <Image x:Name="SourceImage" Stretch="None" SnapsToDevicePixels="True"/>
                    <Canvas x:Name="DrawCanvas" Background="Transparent"
                            MouseLeftButtonDown="OnCanvasMouseDown"
                            MouseMove="OnCanvasMouseMove"
                            MouseLeftButtonUp="OnCanvasMouseUp"/>
                </Grid>
            </Viewbox>
        </Border>
        <Border Grid.Row="2" x:Name="ExternalToolsHost" Margin="0,10,0,0" Padding="8,6"
                Background="{DynamicResource PanelBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel x:Name="ExternalToolsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
