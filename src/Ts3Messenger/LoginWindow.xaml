<Window x:Class="Ts3Messenger.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TS3 Messenger — Sign in"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border Width="400" Margin="28" CornerRadius="20"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.28" Color="Black"/>
        </Border.Effect>
        <Grid>
            <StackPanel Margin="30,18,30,26">
                <StackPanel x:Name="DragHeader" MouseLeftButtonDown="OnHeaderDrag" Cursor="SizeAll"
                            Margin="0,28,0,0">
                    <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Center"
                            ClipToBounds="True" Margin="0,0,0,14">
                        <Border.Background>
                            <ImageBrush x:Name="LogoBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="TS3 Messenger" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Sign in to continue" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>
                </StackPanel>

                <TextBlock Text="Server URL" FontSize="12" FontWeight="Medium" Margin="2,0,0,6"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox x:Name="ServerBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>

                <TextBlock Text="Login ID" FontSize="12" FontWeight="Medium" Margin="2,0,0,6"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox x:Name="LoginBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>

                <TextBlock Text="Password" FontSize="12" FontWeight="Medium" Margin="2,0,0,6"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,14"/>

                <CheckBox x:Name="RememberCheck" Content="Remember me" Style="{StaticResource ModernCheckBoxStyle}"
                          Margin="2,0,0,8"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           FontSize="12.5" Margin="2,4,0,10" MinHeight="0"/>
                <Button x:Name="SignInButton" Content="Sign in" Click="OnLogin" IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" MinHeight="46" FontSize="14.5"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>

            <Button x:Name="ThemeToggleButton" Style="{StaticResource IconButtonStyle}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                    Click="OnToggleTheme" ToolTip="Toggle light / dark theme"/>
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8BB;"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                    Click="OnCloseClick" ToolTip="Close"/>
        </Grid>
    </Border>
</Window>
