<Window x:Class="Ts3Messenger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ts3Messenger.Controls"
        xmlns:ewpf="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="TS3 Messenger" Height="720" Width="1080" MinHeight="420" MinWidth="560"
        Background="{DynamicResource SurfaceBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="230" MaxWidth="480"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,14,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MyAvatar" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center">
                        <TextBlock x:Name="MyAvatarText" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MyIdText" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MyIpText" FontSize="12" Margin="0,1,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="ThemeToggleButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                            Click="OnToggleTheme" ToolTip="Toggle light / dark theme"/>
                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE7E8;"
                            Click="OnLogout" ToolTip="Log out" Margin="2,0,0,0"/>
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="12,2,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ChatListMenuButton" Width="40" Height="40" Content="&#xE700;" FontSize="16"
                            Style="{StaticResource IconButtonStyle}" ToolTip="New Group, Multi message"
                            Click="OnChatListMenu"/>
                <Border Grid.Column="1" Margin="8,0,0,0" Height="40" CornerRadius="12" BorderThickness="1.5"
                        VerticalAlignment="Center" MouseLeftButtonDown="OnSearchFieldClick">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ContactSearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource TextSubtleBrush}" Margin="12,0,6,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Grid Grid.Column="1" Margin="0,0,12,0">
                            <TextBox x:Name="ContactSearchBox" FontSize="13.5" MinHeight="36"
                                     Padding="0" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextChanged="OnContactSearchChanged">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                                      Focusable="False"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock x:Name="ContactSearchPlaceholder" Text="Search" FontSize="13.5"
                                       Foreground="{DynamicResource TextSubtleBrush}" Margin="0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <ListBox x:Name="ContactList" Margin="0,0,0,8"
                         Style="{StaticResource ContactListBoxStyle}"
                         ItemContainerStyle="{StaticResource ContactListItemStyle}"
                         SelectionChanged="OnContactSelected"
                         PreviewMouseRightButtonUp="OnContactRightClick">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ChatScrollBar}"/>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding AvatarBrush, Mode=OneWay}"/>
                                    <TextBlock Text="{Binding Initial, Mode=OneWay}" Foreground="White"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding PersonMarkVisibility, Mode=OneWay}"/>
                                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding GroupMarkVisibility, Mode=OneWay}"/>
                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,-1,-1" StrokeThickness="2"
                                             Fill="{DynamicResource SuccessBrush}"
                                             Stroke="{DynamicResource SidebarBrush}"
                                             Visibility="{Binding OnlineDotVisibility, Mode=OneWay}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LoginId, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ewpf:TextBlock Text="{Binding SubtitleText, Mode=OneWay}" FontSize="12" Margin="0,1,0,0"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="24">
                                    <TextBlock Text="{Binding PreviewTime, Mode=OneWay}" FontSize="11"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               HorizontalAlignment="Right"/>
                                    <Border Background="{DynamicResource BadgeBrush}" CornerRadius="8"
                                            MinWidth="16" Height="16" Padding="5,0" Margin="0,3,0,0"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding BadgeVisibility, Mode=OneWay}">
                                        <TextBlock Text="{Binding UnreadBadgeText, Mode=OneWay}"
                                                   Foreground="{DynamicResource OnAccentBrush}" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right"
                      VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- ===== Chat ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="ChatHeader" Grid.Row="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="18,9,10,9" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                            Background="{Binding AvatarBrush, Mode=OneWay}">
                        <TextBlock Text="{Binding Initial, Mode=OneWay}" Foreground="White" FontWeight="SemiBold"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="ChatTitleHost" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                                MouseLeftButtonUp="OnGroupTitleClick">
                        <TextBlock x:Name="ChatTitle" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding PresenceText, Mode=OneWay}" FontSize="12.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding LanIpLabel, Mode=OneWay}" FontSize="12.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding LanIpVisibility, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="MessageSelectionPanel" Orientation="Horizontal"
                                    Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock x:Name="MessageSelectionLabel" VerticalAlignment="Center" FontWeight="Medium"
                                       Margin="0,0,10,0" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Button Content="Select all" Click="OnSelectAllMessages"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Copy" Click="OnCopySelectedMessages"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Delete" Click="OnDeleteSelectedMessages"
                                    Style="{StaticResource DangerButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Cancel" Click="OnClearMessageSelection"
                                    Style="{StaticResource GhostButtonStyle}"/>
                        </StackPanel>
                        <Button x:Name="ChatMenuButton" Style="{StaticResource IconButtonStyle}" Content="&#xE712;"
                                Click="OnChatMenuClick" ToolTip="More"/>
                    </StackPanel>
                    <Popup x:Name="GroupMembersPopup" PlacementTarget="{Binding ElementName=ChatTitle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12" MinWidth="220" MaxWidth="280">
                            <StackPanel x:Name="GroupMembersPanel"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Border x:Name="ChatAreaBorder" Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
                <Grid>
                    <ScrollViewer x:Name="MessageScroll" Style="{StaticResource ChatMessageScrollViewerStyle}"
                                  ContextMenuOpening="OnMessageScrollContextMenuOpening"
                                  ScrollChanged="OnMessageScrollChanged">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ChatScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="MessageList" Margin="16,10,14,12"/>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center"
                                Background="{DynamicResource DateChipBrush}">
                            <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                       Foreground="{DynamicResource DateChipTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource DateChipBrush}" CornerRadius="14"
                                Padding="14,6" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="Select a chat to start messaging" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource DateChipTextBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" x:Name="FileProgressPanel" Orientation="Horizontal"
                        Margin="20,0,20,8" Visibility="Collapsed">
                <controls:CircularProgress x:Name="FileProgressRing"
                    DataContext="{Binding ElementName=FileProgressPanel, Path=Tag}"/>
                <TextBlock x:Name="FileProgressText" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <Border x:Name="ComposePanel" Grid.Row="3" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="12,9,12,10" Visibility="Collapsed">
                <StackPanel>
                    <Border x:Name="ReplyPreviewPanel" Margin="4,0,4,8" Padding="10,4,4,4"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ReplyPreviewTitle" Text="Reply" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <ewpf:TextBlock x:Name="ReplyPreviewText" TextWrapping="NoWrap" FontSize="12.5"
                                                TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,2,0,0"
                                                Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE711;" Click="OnCancelReply"
                                    Style="{StaticResource IconButtonStyle}" Width="30" Height="30" FontSize="12"
                                    ToolTip="Cancel reply"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="21" Padding="3,2,3,2"
                                MinHeight="42">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="EmojiButton" Click="OnEmojiPickerToggle" Content="&#xE76E;"
                                        Style="{StaticResource IconButtonStyle}" FontSize="18"
                                        VerticalAlignment="Bottom" ToolTip="Emoji"/>
                                <Grid Grid.Column="1">
                                    <ewpf:RichTextBox x:Name="ComposeBox"
                                             Style="{StaticResource ComposeRichTextBoxStyle}"
                                             AcceptsReturn="True"
                                             AcceptsTab="False"
                                             VerticalAlignment="Center"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="34"
                                             MaxHeight="140"
                                             Margin="2,0,2,0">
                                        <ewpf:RichTextBox.Resources>
                                            <Style TargetType="Paragraph">
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </ewpf:RichTextBox.Resources>
                                    </ewpf:RichTextBox>
                                    <TextBlock x:Name="ComposePlaceholder" Text="Write a message…" FontSize="14"
                                               Foreground="{DynamicResource TextSubtleBrush}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <Button x:Name="SnapshotButton" Grid.Column="2" Click="OnSnapshotButtonClick"
                                        Content="&#xE722;" Style="{StaticResource IconButtonStyle}" FontSize="17"
                                        VerticalAlignment="Bottom" ToolTip="Snapshot"/>
                                <Button x:Name="PlusButton" Grid.Column="3" Click="OnPlusButtonClick"
                                        Content="&#xE723;" Style="{StaticResource IconButtonStyle}" FontSize="17"
                                        VerticalAlignment="Bottom" ToolTip="Attach file or folder"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Click="OnSend" Content="&#xE724;" Margin="8,0,0,0"
                                Style="{StaticResource SendButtonStyle}" VerticalAlignment="Bottom"
                                ToolTip="Send (Enter)"/>
                        <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                            <controls:EmojiPicker x:Name="EmojiPickerControl"/>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
