<UserControl x:Class="Ts3Messenger.Controls.CircularProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="72" Height="72">
    <Grid>
        <Ellipse Width="72" Height="72" Stroke="{DynamicResource ProgressTrackBrush}" StrokeThickness="6"/>
        <Ellipse Width="72" Height="72" Stroke="{DynamicResource AccentBrush}" StrokeThickness="6"
                 StrokeDashArray="4 1"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform Angle="-90"/>
            </Ellipse.RenderTransform>
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="StrokeDashArray" Value="0 1000"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Percent}" Value="0">
                            <Setter Property="StrokeDashArray" Value="0 1000"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="64"/>
        </StackPanel>
    </Grid>
</UserControl>
